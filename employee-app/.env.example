# Required runtime mode: local-emulator or production
EXPO_PUBLIC_SERVICESOS_FIREBASE_MODE=

# Public Firebase client configuration (never place server credentials here)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Required in local-emulator mode; choose a host reachable from the device
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
EXPO_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
EXPO_PUBLIC_FIREBASE_STORAGE_EMULATOR_PORT=9199
EXPO_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_PORT=5001
