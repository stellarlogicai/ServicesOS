    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.servicesos.employee"
    },
    "android": {
      "package": "com.servicesos.employee"
    },
    "plugins": [
      "expo-image-picker",
      "expo-location"
    ]
  }
}
